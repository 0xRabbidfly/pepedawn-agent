# ============================================
# 🔑 API KEYS & AUTHENTICATION (REQUIRED)
# ============================================
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# Get from: https://replicate.com/account/api-tokens (for /ft duplicate detection)
REPLICATE_API_TOKEN=r8_your-token-here

# ============================================
# 📱 TELEGRAM CONFIGURATION (REQUIRED)
# ============================================
# Get from @BotFather: /newbot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Your Telegram user ID (get from @userinfobot) - comma-separated for multiple admins
TELEGRAM_ADMIN_IDS=123456789
# Optional: admin @handles, comma separated. Admins bypass the /fr artist gate.
TELEGRAM_ADMIN_USERNAMES=rabbidfly
# Optional: where the character roster lives — the forum's special characters and
# how PEPEDAWN treats each of them. Format in src/data/characters.example.json.
# Keyed on numeric Telegram user ids only. Keep it on the server; never commit it.
# CHARACTERS_PATH=src/data/characters.json
# Optional: override where accepted /fr lore submissions are logged.
# LORE_LEDGER_PATH=src/data/lore-ledger.json
# Optional: override where command rate-limit state is persisted.
# RATE_LIMIT_PATH=src/data/rate-limits.json
# Optional: override where open lore proposals awaiting vouches are stored.
# PROPOSALS_PATH=src/data/lore-proposals.json
# Optional: override the participant standing registry used to qualify vouchers.
# PARTICIPANTS_PATH=src/data/participants.json

# ============================================
# 📢 MARKET NOTIFICATIONS (OPTIONAL)
# ============================================
# Telegram channel/group IDs for market notifications (comma-separated)
# Get group ID: Add @userinfobot to group, it will show the ID (negative number)
# TELEGRAM_CHANNEL_ID=-1001234567890

# Sale celebration sticker ID (optional - shows after sales)
# TELEGRAM_SALE_STICKER_ID=your-sticker-id-here

# ============================================
# 🗄️ DATABASE (OPTIONAL - uses default if not set)
# ============================================
# PGLITE_DATA_DIR=.eliza/.elizadb

# ============================================
# 📊 TRANSACTION MONITORING (OPTIONAL)
# ============================================
# Poll Counterparty blockchain every N seconds (default: 180)
# POLL_INTERVAL_SECONDS=180

# TEST ONLY: Start polling from specific block (leave empty for production)
# TEST_START_BLOCK=921542

# ============================================
# 💡 PERIODIC CONTENT (OPTIONAL)
# ============================================
# Enable periodic helpful tips and card showcases in Telegram channel
# PERIODIC_CONTENT_ENABLED=true

# How often to check for posting opportunities (default: 60 minutes)
# Content only posts if there's been user activity since last post
# PERIODIC_CONTENT_INTERVAL_MINUTES=60

# ============================================
# 🤖 LLM MODELS (OPTIONAL - sensible defaults)
# ============================================
# Default models for bot responses (gpt-4o-mini recommended for cost savings)
# OPENAI_SMALL_MODEL=gpt-5.6-luna
# OPENAI_LARGE_MODEL=gpt-5.6-luna
# Conversational replies. Falls back to OPENAI_LARGE_MODEL.
CHAT_MODEL=gpt-5.6-luna

# Premium model for /fl lore stories (default: gpt-4o-mini)
# LORE_STORY_MODEL=gpt-5

# Vision model for /fv and /ft commands (default: gpt-4o)
# VISUAL_MODEL=gpt-4o

# ============================================
# 🧠 KNOWLEDGE BASE (OPTIONAL - for /fl lore command)
# ============================================
# Path to knowledge documents
# KNOWLEDGE_PATH=./docs/chunks

# Load knowledge on startup (required for /fl to work)
# LOAD_DOCS_ON_STARTUP=true

# Embedding model (text-embedding-3-small is 6.5x cheaper than ada-002)
# TEXT_EMBEDDING_MODEL takes precedence over OPENAI_EMBEDDING_MODEL, both in
# @elizaos/plugin-knowledge and in the /fc cost attribution
# TEXT_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# Trait-aware card discovery reranker (defaults shown)
# CARD_TRAIT_RERANK_ENABLED=true
# CARD_TRAIT_RERANK_MIN_SCORE=0.55

# ============================================
# ⚡ RATE LIMITS & PERFORMANCE (OPTIONAL)
# ============================================
# Token constraints (usually don't need to change)
# MAX_INPUT_TOKENS=8000
# MAX_OUTPUT_TOKENS=4096

# Concurrent requests (advanced tuning)
# MAX_CONCURRENT_REQUESTS=30
# REQUESTS_PER_MINUTE=60
# TOKENS_PER_MINUTE=150000

# ============================================
# 🎨 UI/UX SETTINGS (OPTIONAL)
# ============================================
# Show artist profile buttons on /f card displays (default: true)
# FAKE_RARES_ARTIST_BUTTONS=true

# Hide source citations in /fl lore responses (default: false)
# HIDE_LORE_SOURCES=false

# Suppress ElizaOS bootstrap conversations (default: false)
# Set to true to reduce costs - bot only responds to commands/capitals/replies/@mentions
# SUPPRESS_BOOTSTRAP=true

# Engagement threshold - minimum score for bot to respond (default: 25)
# Lower = more chatty, Higher = more selective
# Optimized via Monte Carlo V2 (72k configs, 264k messages): 25 = ~24% response rate
# Target engagement: Bot-directed 100%, Questions 76%, Cards 43%, Overall 24%
# ENGAGEMENT_THRESHOLD=25

# ============================================
# 📦 MEDIA HANDLING (OPTIONAL)
# ============================================
# Convert large GIFs to MP4 for Telegram delivery (default: 8MB)
# Larger GIFs are automatically converted to compressed MP4 videos
# GIF_URL_MAX_MB=8

# Telegram file_id cache location (default: src/data/telegram-file-ids.json)
# Caches uploaded media to avoid re-uploading same files
# TELEGRAM_CACHE_FILE=src/data/telegram-file-ids.json

# ============================================
# 🔧 DEVELOPMENT & DEBUGGING (OPTIONAL)
# ============================================
# Where TelemetryService writes its JSONL logs — the data behind /fc.
# Defaults to ./src/data. Tests point this at a scratch directory so they
# cannot append fixtures to the real cost logs.
# TELEMETRY_DATA_DIR=./src/data

# Log level: debug | info | warn | error (default: info)
# LOG_LEVEL=info

# Environment (set to production on server)
# NODE_ENV=production

# ============================================
# 🎰 LOTTERY INTEGRATION (OPTIONAL)
# ============================================
# PEPEDAWN.ART raffle contract (if using /odds command)
# ETHEREUM_NETWORK=mainnet
# ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
# CONTRACT_ADDRESS=0xYourContractAddressHere

# ============================================
# 🧪 V5 SHADOW MODE (OPTIONAL)
# ============================================
# V5_SHADOW: runs the v5 axes alongside the live pipeline, recording what they
# would decide without changing behaviour. For measuring a rollout against real
# users. See telegram_docs/design_docs/PEPEDAWN_CHAT_V5.md
# V5_SHADOW=false
#
# V5_ENFORCE: makes the cadence governor binding - it actually suppresses
# replies. Implies V5_SHADOW. Default on the test bot via scripts/run-testbot.sh
# V5_ENFORCE=false
#
# Where shadow-logs.jsonl and room-history.json are written.
# Defaults to ./src/data
# V5_SHADOW_DIR=

# ============================================
# 🔎 RETRIEVAL (OPTIONAL)
# ============================================
# The frozen Telegram archive is excluded from RAG. It ends 2025-10-11, 22% of
# it is misclassified as authoritative wiki, and its strongest hits are
# form-matches rather than answers. Set true only to compare against the old
# behaviour.
# RAG_INCLUDE_TELEGRAM=false
#
# Append the retrieval sources line to replies. Leaks internal record ids into
# the room; useful when debugging retrieval, noise otherwise.
# SHOW_SOURCES=false

# ============================================
# X / TWITTER (read-only reconnaissance)
# ============================================
#
# OAuth2 app-only bearer token, used ONLY by scripts/x-probe.ts to survey what
# artist and community activity is available on X. Nothing in the running bot
# reads it, and the probe never writes to the database or the lore corpus.
#
# X is pay-per-use as of April 2026 (~$0.005 per post read), so every call
# costs money. The probe spends nothing without an explicit --budget.
# X_BEARER_TOKEN=
#
# ============================================
# X HARVEST (community activity from X)
# ============================================
#
# Harvests recent Fake Rares / Rare Pepes activity from X via the xAI Agent
# Tools API (grok x_search), and volunteers an item into the channel when the
# room has gone quiet. Harvested posts are quoted and attributed, never added
# to the knowledge corpus - see src/utils/xHarvest.ts for why.
#
# Requires XAI_API_KEY (xAI / Grok, NOT an X data API bearer token - different
# products). Measured cost is roughly $0.03 per query on grok-4.3.
#
# The interval is anchored to a timestamp in the harvest store, not to process
# uptime: production restarts nightly and on every deploy, and an in-memory
# timer meant each restart bought a fresh round of paid queries.
#
# Keep XAI_MODEL on a *reasoning* model. Switching to
# grok-4.20-0309-non-reasoning measured 2.3x MORE expensive - with nothing
# narrowing the search, x_search poured 65k tokens of raw results into the
# request instead of 8k. It is roughly 3x faster, if latency ever matters more.
# X_HARVEST_ENABLED=false
#
# Accounts harvested by name every round and offered first when a post is
# volunteered into a quiet room. @scrillaventura and @fakerares_xcp are always
# on the list; this adds to it, comma separated.
# X_MUST_FOLLOW=
# X_HARVEST_INTERVAL_HOURS=24
# XAI_MODEL=grok-4.3
#
# xAI API key. Also used by scripts/x-probe.ts.
# XAI_API_KEY=
#
# Override the harvest store path (tests only).
# X_HARVEST_PATH=

# --- Daily recap strip (/recap, and the nightly post) -------------------------
# The recap is built at boot and covers the day that just ended. PM2 cron-restarts
# at 02:00, so that boot is the schedule; a persisted day stamp in
# src/data/recap-state.json keeps deploys from posting a second strip.
# Off unless explicitly enabled.
RECAP_ENABLED=false
# Where the nightly strip is posted. Defaults to TELEGRAM_CHANNEL_ID.
# RECAP_CHANNEL_IDS=-1001586933558
# Only post inside this local-hour window, so an afternoon deploy does not
# post last night's recap to a room that has moved on.
RECAP_EARLIEST_HOUR=2
RECAP_LATEST_HOUR=10
# How long to let the bot settle after boot before spending a model call.
RECAP_SETTLE_MS=90000
# Which model picks the moments. It never writes dialogue; quotes are verbatim.
RECAP_MODEL=gpt-5.6-luna
# Where the persisted chat-to-room pairing lives. The nightly runs 90 seconds
# after the 02:00 restart, before any message has taught the in-memory map
# which room a chat is, so it reads this file instead.
# ROOM_MAP_PATH=src/data/room-map.json

# --- Social memory (what PEPEDAWN remembers about each person) ----------------
# off: nothing. record: capture only; memories accumulate in the file below but
# never reach a reply. on: capture, and a speaker's memories shape replies to them.
# Capture reads the day log from group chats only, 150s after boot and every 3h.
# SOCIAL_MEMORY=off
# Where memories live. Gitignored: attributed quotes keyed by Telegram id must
# never be committed to this public repo. Hand edits are picked up live.
# SOCIAL_MEMORY_PATH=src/data/social-memory.json
# Most memories per person, and most new ones per person per day. A roster
# entry in characters.json can override either for one person ("memory").
# SOCIAL_MEMORY_CAP=30
# SOCIAL_MEMORY_PER_DAY=2
# Which model chooses what to remember. Defaults to CHAT_MODEL.
# SOCIAL_MEMORY_MODEL=gpt-5.6-luna
# Limit capture to these chats, comma separated. Defaults to every group chat seen.
# SOCIAL_MEMORY_CHAT_IDS=-1001586933558

# --- Staying out of other people's conversations -----------------------------
# How recently somebody OTHER than the speaker must have spoken for PEPEDAWN to
# stay out of a message nobody aimed at it. Direct address - a mention, a reply,
# a DM, its name, a command - always gets through, as do exact card answers.
# 0 switches the rule off entirely. Default 120.
# STAY_OUT_SECONDS=120
# Since 5.14.0 PEPEDAWN answers uninvited only what the card index knows
# exactly, and never comments on an uninvited statement. true restores the old
# behaviour (volunteering composed answers and comments in a group).
# VOLUNTEER_REPLIES=false

# --- "What's new" post on upgrade --------------------------------------------
# Posts the section for the running version from docs/WHATS_NEW.md, once, a
# minute after the first boot on that version. A restart with no version change
# posts nothing, and a version with no section posts nothing.
# RELEASE_NOTES_ENABLED=false
# Where to post it. Defaults to TELEGRAM_CHANNEL_ID.
# RELEASE_NOTES_CHANNEL_IDS=-1001586933558

# --- Fake Rares 5th birthday (one day) ----------------------------------------
# Runs the timeline in src/data/fakerares5-schedule.json: history drops, card of
# the hour, the Scrilla counter, inline-keyboard trivia, a closer. Posts once
# each, recorded in anniversary-state.json, so restarts re-send nothing. While
# the event day is on, the hourly periodic showcase stands down. Off by default.
# ANNIVERSARY_ENABLED=false
# ANNIVERSARY_SCHEDULE_PATH=src/data/fakerares5-schedule.json
# ANNIVERSARY_STATE_PATH=src/data/anniversary-state.json
# Telegram ids that may not enter the lore contest (the prize's makers), comma
# separated. Kept out of the committed schedule because this repo is public.
# ANNIVERSARY_EXCLUDED_IDS=123456789,987654321
# Preview without Telegram:  bun scripts/anniversary-preview.ts --dry-run | --fast-forward

# --- Card index source -------------------------------------------------------
# scripts/sync-directory.ts reconciles src/data/fake-rares-data.json with the
# canonical directory once a day (from the update-fake-rares workflow).
# DIRECTORY_API=https://fakeraredirectory.com/api/cards

# --- Card index refresh ------------------------------------------------------
# Where the daily index refresh downloads fake-rares-data.json from. Defaults
# to master on GitHub, which is what production runs. Point a branch build
# (the test bot) at its own raw URL, or master's older file replaces the
# branch's index five minutes after boot.
# CARD_INDEX_REFRESH_URL=https://raw.githubusercontent.com/0xRabbidfly/pepedawn-agent/feature/directory-canon/pepe-tg/src/data/fake-rares-data.json

# --- Artist spotlight (KEK-001) ----------------------------------------------
# One directory artist a day: a card of theirs at each hour below, with a haiku
# from the card's visual facts, and a low-voltage prod to claim their page
# until SPOTLIGHT_PROD_UNTIL. State in src/data/spotlight-state.json.
# SPOTLIGHT_ENABLED=true
# SPOTLIGHT_HOURS_UTC=15,19,23
# SPOTLIGHT_MIN_GAP_HOURS=2
# SPOTLIGHT_REPEAT_DAYS=60
# SPOTLIGHT_PROD_UNTIL=2026-10-22
# SPOTLIGHT_MODEL=gpt-5.6-terra
# Artists' Telegram handles, taught by admins replying to a spotlight with a
# bare @handle. Server only; gitignored.
# ARTIST_TELEGRAM_PATH=src/data/artist-telegram.json

# --- GIFs: PEPEDAWN draws Pepe memes -----------------------------------------
# /fgif <idea> for anyone (GIF_PER_PERSON_PER_DAY, admins uncapped), and now
# and then an invited reply becomes a GIF instead of words (GIF_RATE of them,
# never twice in a room inside GIF_COOLDOWN_MIN). Needs OPENAI_API_KEY and
# ffmpeg. About 5 cents a GIF: the concept model plus one gpt-image-1 frame.
# GIF_ENABLED=true
# GIF_RATE=0.1
# GIF_COOLDOWN_MIN=30
# GIF_PER_PERSON_PER_DAY=3
# GIF_IMAGE_QUALITY=medium
# GIF_CONCEPT_MODEL=gpt-5.6-terra
# GIF_FONT=src/assets/fonts/Anton-Regular.ttf
# GIF_STATE_PATH=src/data/gif-state.json

# --- Voice: sometimes PEPEDAWN talks instead of typing -----------------------
# A conversational reply is spoken as a Telegram voice bubble, through
# OpenAI text-to-speech (gpt-4o-mini-tts, $0.60 per million characters), at
# VOICE_RATE of the time when it is short and plain, never twice in a room
# inside the cooldown. "say it" / "out loud" in the ask forces voice; "write
# it" / "in text" forces text. Needs OPENAI_API_KEY. Off with "false".
# VOICE_ENABLED=true
# VOICE_RATE=0.25
# VOICE_MAX_CHARS=420
# VOICE_COOLDOWN_MIN=10
# The voice (alloy, ash, ballad, coral, echo, fable, onyx, nova, sage,
# shimmer, verse) and how to play it - the personality is in the words; this
# is the throat. Change either without a deploy.
# VOICE_NAME=ballad
# VOICE_STYLE=You are PEPEDAWN, a swamp frog who learned to talk from crypto Telegram, but drunk at 3am: slurred edges, wandering pitch, a burp-like croak, sudden loud confidence, then trailing off. Not noble, not smooth, not an assistant.
# VOICE_MODEL=gpt-4o-mini-tts
# Two more knobs, off by default: VOICE_SLUR=true writes the words slurred
# before synthesis; VOICE_WARP=default (or an ffmpeg -af chain) lowers,
# slows and wobbles the audio afterwards. The owner chose the plain read.
# VOICE_SLUR=false
# VOICE_WARP=

# --- API credits, for /fc ----------------------------------------------------
# Neither OpenAI nor xAI exposes a balance to an API key, so /fc estimates what
# is left from what was loaded and when: the amount, and the date it was loaded
# (YYYY-MM-DD). /fc subtracts the telemetry ledger's spend on that provider's
# models since that date. Update both when you top up.
# OPENAI_CREDIT_USD=100
# OPENAI_CREDIT_SINCE=2026-09-01
# XAI_CREDIT_USD=25
# XAI_CREDIT_SINCE=2026-09-01
# Where /fb tickets are logged (gitignored; quotes real people).
# BUILD_REQUESTS_PATH=src/data/maintainer/build-requests.jsonl
# When a deploy brings a commit with "Ticket: KEK-nnn", the bot marks the
# ticket shipped and tells the channel. Off with "false".
# BACKLOG_ANNOUNCEMENTS=true

# --- Scheduled reminders -----------------------------------------------------
# src/data/reminders.json lists broadcasts posted to TELEGRAM_CHANNEL_ID once
# a day inside their window (the artist claim reminder runs to 2026-10-22).
# State in src/data/reminder-state.json. On unless set to "false".
# REMINDERS_ENABLED=true

# --- New-card announcements --------------------------------------------------
# When the daily index refresh brings a card the bot has not seen, it posts
# the card to TELEGRAM_CHANNEL_ID once, with its directory page as a button
# (at most 3 an hour; state in src/data/new-card-state.json, seeded on first
# boot so nothing old is announced). On unless set to "false".
# NEW_CARD_ANNOUNCEMENTS=true

# --- Card visual facts (what the vision pass saw on each card) ---------------
# src/data/card-visual-facts/<ASSET>.json is the source of truth, written by
# scripts/fv-backfill.ts (daily, from the update workflow, for cards not yet
# seen). At boot CardFactsImportService puts any fact this database lacks into
# knowledge. Set to "off" to skip the boot import.
# CARD_FACTS_IMPORT=on
# Model for the two-sentence summary and keywords per card (the vision call
# itself uses VISUAL_MODEL above). Defaults to gpt-4o-mini.
# CARD_VISUAL_SUMMARY_MODEL=gpt-4o-mini

# --- The maintainer loop, stage 1 (docs/MAINTAINER.md) -----------------------
# scripts/maintainer-digest.ts runs on the droplet from cron and DMs the owner a
# digest of what was asked of the bot and what it did, triaged by who said it.
# Where the digest is sent: the owner's DM chat id.
# MAINTAINER_OWNER_CHAT_ID=
# Who may direct a change, on top of TELEGRAM_ADMIN_IDS: numeric Telegram ids,
# comma separated (the group owner). Everyone else is a suggestion.
# MAINTAINER_DIRECTIVE_IDS=
# Which chats to read. Defaults to TELEGRAM_CHANNEL_ID.
# MAINTAINER_CHAT_IDS=
# Model for the one classification call per digest. Defaults to CHAT_MODEL.
# MAINTAINER_MODEL=

# --- Nightly backup (scripts/nightly-backup.sh) -------------------------------
# Runs from root's crontab on the droplet at 02:00 UTC (scripts/setup-backup-cron.sh).
# Read from the environment or this file; the defaults are right for production.
# Failures are sent to MAINTAINER_OWNER_CHAT_ID above.
# Where archives go. Defaults to ../backups (/root/pepedawn-agent/backups).
# BACKUP_DIR=
# How many nightly archives to keep. Hand-made backups are never pruned.
# BACKUP_KEEP=3
# The PM2 app stopped and started around the copy.
# BACKUP_PM2_APP=pepe-tg

# --- Sticker packs (scripts/make-sticker.ts) ---------------------------------
# A dev script, not bot behaviour: it converts an image or a short animation to
# Telegram's sticker spec and puts it in a pack the bot owns. The pack's short
# name permanently ends in the username of whichever token runs it, so a pack
# made with the test token is called ..._by_pepedawntest_bot forever.
# A sticker pack is owned by a person, not a bot: the numeric Telegram user id
# the pack is created under. Overridden by --owner.
# STICKER_OWNER_ID=
# Where converted sticker files are written. Defaults to pepe-tg/tmp.
# STICKER_OUT_DIR=

# --- Stickers as emoji (src/utils/stickers.ts) -------------------------------
# Telegram's reaction set is fixed and has no frog, so PEPEDAWN could never
# react as itself. A sticker can be any picture, so now and then a reply goes
# out as one from the community pack instead of as words. A sticker is a
# message, not a silent reaction, so it is rarer than everything else the bot
# does: the dice and a per-room cooldown both have to agree, and an exact
# answer is never swapped for one.
# The pack's short name. Defaults to fakerares_by_pepedawn_bot, which is
# deliberate - .env is not deployed, so a required variable would leave the
# feature off on the droplet while WHATS_NEW announced it. Each bot reads the
# pack with its own token, so the file_ids always match the sender.
# STICKER_PACK=fakerares_by_pepedawn_bot
# The one kill switch.
# STICKER_ENABLED=true
# Chance of taking the offer once the cooldown allows one. Default 0.06.
# STICKER_RATE=0.06
# Minutes of quiet per room after one goes out. Default 90.
# STICKER_COOLDOWN_MIN=90
