# ============================================
# 🔑 API KEYS & AUTHENTICATION (REQUIRED)
# ============================================
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# Get from: https://replicate.com/account/api-tokens (for /ft duplicate detection)
REPLICATE_API_TOKEN=r8_your-token-here

# ============================================
# 📱 TELEGRAM CONFIGURATION (REQUIRED)
# ============================================
# Get from @BotFather: /newbot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Your Telegram user ID (get from @userinfobot) - comma-separated for multiple admins
TELEGRAM_ADMIN_IDS=123456789
# Optional: admin @handles, comma separated. Admins bypass the /fr artist gate.
TELEGRAM_ADMIN_USERNAMES=rabbidfly
# Optional: override where accepted /fr lore submissions are logged.
# LORE_LEDGER_PATH=src/data/lore-ledger.json
# Optional: override where command rate-limit state is persisted.
# RATE_LIMIT_PATH=src/data/rate-limits.json
# Optional: override where open lore proposals awaiting vouches are stored.
# PROPOSALS_PATH=src/data/lore-proposals.json
# Optional: override the participant standing registry used to qualify vouchers.
# PARTICIPANTS_PATH=src/data/participants.json

# ============================================
# 📢 MARKET NOTIFICATIONS (OPTIONAL)
# ============================================
# Telegram channel/group IDs for market notifications (comma-separated)
# Get group ID: Add @userinfobot to group, it will show the ID (negative number)
# TELEGRAM_CHANNEL_ID=-1001234567890

# Sale celebration sticker ID (optional - shows after sales)
# TELEGRAM_SALE_STICKER_ID=your-sticker-id-here

# ============================================
# 🗄️ DATABASE (OPTIONAL - uses default if not set)
# ============================================
# PGLITE_DATA_DIR=.eliza/.elizadb

# ============================================
# 📊 TRANSACTION MONITORING (OPTIONAL)
# ============================================
# Poll Counterparty blockchain every N seconds (default: 180)
# POLL_INTERVAL_SECONDS=180

# TEST ONLY: Start polling from specific block (leave empty for production)
# TEST_START_BLOCK=921542

# ============================================
# 💡 PERIODIC CONTENT (OPTIONAL)
# ============================================
# Enable periodic helpful tips and card showcases in Telegram channel
# PERIODIC_CONTENT_ENABLED=true

# How often to check for posting opportunities (default: 60 minutes)
# Content only posts if there's been user activity since last post
# PERIODIC_CONTENT_INTERVAL_MINUTES=60

# ============================================
# 🤖 LLM MODELS (OPTIONAL - sensible defaults)
# ============================================
# Default models for bot responses (gpt-4o-mini recommended for cost savings)
# OPENAI_SMALL_MODEL=gpt-5.6-luna
# OPENAI_LARGE_MODEL=gpt-5.6-luna
# Conversational replies. Falls back to OPENAI_LARGE_MODEL.
CHAT_MODEL=gpt-5.6-luna

# Premium model for /fl lore stories (default: gpt-4o-mini)
# LORE_STORY_MODEL=gpt-5

# Vision model for /fv and /ft commands (default: gpt-4o)
# VISUAL_MODEL=gpt-4o

# ============================================
# 🧠 KNOWLEDGE BASE (OPTIONAL - for /fl lore command)
# ============================================
# Path to knowledge documents
# KNOWLEDGE_PATH=./docs/chunks

# Load knowledge on startup (required for /fl to work)
# LOAD_DOCS_ON_STARTUP=true

# Embedding model (text-embedding-3-small is 6.5x cheaper than ada-002)
# TEXT_EMBEDDING_MODEL takes precedence over OPENAI_EMBEDDING_MODEL, both in
# @elizaos/plugin-knowledge and in the /fc cost attribution
# TEXT_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# Trait-aware card discovery reranker (defaults shown)
# CARD_TRAIT_RERANK_ENABLED=true
# CARD_TRAIT_RERANK_MIN_SCORE=0.55

# ============================================
# ⚡ RATE LIMITS & PERFORMANCE (OPTIONAL)
# ============================================
# Token constraints (usually don't need to change)
# MAX_INPUT_TOKENS=8000
# MAX_OUTPUT_TOKENS=4096

# Concurrent requests (advanced tuning)
# MAX_CONCURRENT_REQUESTS=30
# REQUESTS_PER_MINUTE=60
# TOKENS_PER_MINUTE=150000

# ============================================
# 🎨 UI/UX SETTINGS (OPTIONAL)
# ============================================
# Show artist profile buttons on /f card displays (default: true)
# FAKE_RARES_ARTIST_BUTTONS=true

# Hide source citations in /fl lore responses (default: false)
# HIDE_LORE_SOURCES=false

# Suppress ElizaOS bootstrap conversations (default: false)
# Set to true to reduce costs - bot only responds to commands/capitals/replies/@mentions
# SUPPRESS_BOOTSTRAP=true

# Engagement threshold - minimum score for bot to respond (default: 25)
# Lower = more chatty, Higher = more selective
# Optimized via Monte Carlo V2 (72k configs, 264k messages): 25 = ~24% response rate
# Target engagement: Bot-directed 100%, Questions 76%, Cards 43%, Overall 24%
# ENGAGEMENT_THRESHOLD=25

# ============================================
# 📦 MEDIA HANDLING (OPTIONAL)
# ============================================
# Convert large GIFs to MP4 for Telegram delivery (default: 8MB)
# Larger GIFs are automatically converted to compressed MP4 videos
# GIF_URL_MAX_MB=8

# Telegram file_id cache location (default: src/data/telegram-file-ids.json)
# Caches uploaded media to avoid re-uploading same files
# TELEGRAM_CACHE_FILE=src/data/telegram-file-ids.json

# ============================================
# 🔧 DEVELOPMENT & DEBUGGING (OPTIONAL)
# ============================================
# Where TelemetryService writes its JSONL logs — the data behind /fc.
# Defaults to ./src/data. Tests point this at a scratch directory so they
# cannot append fixtures to the real cost logs.
# TELEMETRY_DATA_DIR=./src/data

# Log level: debug | info | warn | error (default: info)
# LOG_LEVEL=info

# Environment (set to production on server)
# NODE_ENV=production

# ============================================
# 🎰 LOTTERY INTEGRATION (OPTIONAL)
# ============================================
# PEPEDAWN.ART raffle contract (if using /odds command)
# ETHEREUM_NETWORK=mainnet
# ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
# CONTRACT_ADDRESS=0xYourContractAddressHere

# ============================================
# 🧪 V5 SHADOW MODE (OPTIONAL)
# ============================================
# V5_SHADOW: runs the v5 axes alongside the live pipeline, recording what they
# would decide without changing behaviour. For measuring a rollout against real
# users. See telegram_docs/design_docs/PEPEDAWN_CHAT_V5.md
# V5_SHADOW=false
#
# V5_ENFORCE: makes the cadence governor binding - it actually suppresses
# replies. Implies V5_SHADOW. Default on the test bot via scripts/run-testbot.sh
# V5_ENFORCE=false
#
# Where shadow-logs.jsonl and room-history.json are written.
# Defaults to ./src/data
# V5_SHADOW_DIR=

# ============================================
# 🔎 RETRIEVAL (OPTIONAL)
# ============================================
# The frozen Telegram archive is excluded from RAG. It ends 2025-10-11, 22% of
# it is misclassified as authoritative wiki, and its strongest hits are
# form-matches rather than answers. Set true only to compare against the old
# behaviour.
# RAG_INCLUDE_TELEGRAM=false
#
# Append the retrieval sources line to replies. Leaks internal record ids into
# the room; useful when debugging retrieval, noise otherwise.
# SHOW_SOURCES=false

# ============================================
# X / TWITTER (read-only reconnaissance)
# ============================================
#
# OAuth2 app-only bearer token, used ONLY by scripts/x-probe.ts to survey what
# artist and community activity is available on X. Nothing in the running bot
# reads it, and the probe never writes to the database or the lore corpus.
#
# X is pay-per-use as of April 2026 (~$0.005 per post read), so every call
# costs money. The probe spends nothing without an explicit --budget.
# X_BEARER_TOKEN=
#
# ============================================
# X HARVEST (community activity from X)
# ============================================
#
# Harvests recent Fake Rares / Rare Pepes activity from X via the xAI Agent
# Tools API (grok x_search), and volunteers an item into the channel when the
# room has gone quiet. Harvested posts are quoted and attributed, never added
# to the knowledge corpus - see src/utils/xHarvest.ts for why.
#
# Requires XAI_API_KEY (xAI / Grok, NOT an X data API bearer token - different
# products). Measured cost is roughly $0.03 per query on grok-4.3.
#
# The interval is anchored to a timestamp in the harvest store, not to process
# uptime: production restarts nightly and on every deploy, and an in-memory
# timer meant each restart bought a fresh round of paid queries.
#
# Keep XAI_MODEL on a *reasoning* model. Switching to
# grok-4.20-0309-non-reasoning measured 2.3x MORE expensive - with nothing
# narrowing the search, x_search poured 65k tokens of raw results into the
# request instead of 8k. It is roughly 3x faster, if latency ever matters more.
# X_HARVEST_ENABLED=false
# X_HARVEST_INTERVAL_HOURS=24
# XAI_MODEL=grok-4.3
#
# xAI API key. Also used by scripts/x-probe.ts.
# XAI_API_KEY=
#
# Override the harvest store path (tests only).
# X_HARVEST_PATH=

# --- Daily recap strip (/recap, and the nightly post) -------------------------
# The recap is built at boot and covers the day that just ended. PM2 cron-restarts
# at 02:00, so that boot is the schedule; a persisted day stamp in
# src/data/recap-state.json keeps deploys from posting a second strip.
# Off unless explicitly enabled.
RECAP_ENABLED=false
# Where the nightly strip is posted. Defaults to TELEGRAM_CHANNEL_ID.
# RECAP_CHANNEL_IDS=-1001586933558
# Only post inside this local-hour window, so an afternoon deploy does not
# post last night's recap to a room that has moved on.
RECAP_EARLIEST_HOUR=2
RECAP_LATEST_HOUR=10
# How long to let the bot settle after boot before spending a model call.
RECAP_SETTLE_MS=90000
# Which model picks the moments. It never writes dialogue; quotes are verbatim.
RECAP_MODEL=gpt-5.6-luna
